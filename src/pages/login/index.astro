---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LoginForm from '../../components/LoginForm.svelte';

const publicApiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:1337';
---

<BaseLayout title="Sign In" description="Sign in to your Hunter Albert account.">

  <section class="min-h-[calc(100vh-4rem)] bg-navy-950 flex items-center justify-center py-16 px-4">
    <div class="w-full max-w-md">

      <!-- Logo / brand -->
      <div class="text-center mb-8">
        <a href="/" class="inline-block text-white font-extrabold text-2xl hover:text-blue-400 transition-colors">
          Hunter Albert
        </a>
        <p class="text-navy-400 text-sm mt-1">Sign in to your account</p>
      </div>

      <!-- Card -->
      <div class="bg-navy-900 border border-navy-700 rounded-2xl p-8 shadow-2xl shadow-navy-950">
        <LoginForm client:load apiUrl={publicApiUrl} />
      </div>

      <!-- Footer links -->
      <p class="text-center text-navy-500 text-xs mt-6">
        By signing in, you agree to our
        <a href="/legal/terms" class="text-navy-400 hover:text-white transition-colors">Terms of Service</a>
        and
        <a href="/legal/privacy" class="text-navy-400 hover:text-white transition-colors">Privacy Policy</a>.
      </p>

    </div>
  </section>

</BaseLayout>
