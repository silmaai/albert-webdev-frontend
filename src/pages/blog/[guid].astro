---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogByGuid } from '../../lib/api';

// SSR mode — no getStaticPaths
const { guid } = Astro.params;

if (!guid) {
  return Astro.redirect('/blog');
}

let blog = null;
let fetchError = false;

try {
  blog = await getBlogByGuid(guid);
} catch {
  fetchError = true;
}

if (!blog && !fetchError) {
  return Astro.redirect('/blog');
}

const tags: string[] = Array.isArray(blog?.tags) ? blog.tags : [];
---

<BaseLayout
  title={blog?.long_title ?? blog?.short_title ?? 'Blog Post'}
  description={blog?.short_description ?? ''}
>

  {fetchError && (
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-20 text-center">
      <h1 class="text-white text-2xl font-bold mb-4">Unable to load this post</h1>
      <p class="text-navy-400 mb-6">There was a problem fetching the article. Please try again.</p>
      <a href="/blog" class="text-blue-400 hover:text-blue-300 transition-colors font-semibold">← Back to Blog</a>
    </div>
  )}

  {!fetchError && blog && (
    <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-14">

      <!-- Breadcrumb -->
      <nav class="text-sm text-navy-400 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span class="mx-2">/</span>
        <a href="/blog" class="hover:text-white transition-colors">Blog</a>
        <span class="mx-2">/</span>
        <span class="text-navy-300 truncate">{blog.short_title}</span>
      </nav>

      <!-- Category -->
      {blog.category && (
        <span class="inline-block bg-blue-900/60 text-blue-300 text-xs font-semibold px-3 py-1 rounded-full mb-4">
          {blog.category}
        </span>
      )}

      <!-- Title -->
      <h1 class="text-white text-3xl sm:text-4xl font-extrabold leading-tight mb-6">
        {blog.long_title || blog.short_title}
      </h1>

      <!-- Author strip -->
      <div class="flex items-center gap-4 mb-10 pb-8 border-b border-navy-700">
        {blog.author_image ? (
          <img
            src={blog.author_image}
            alt={blog.author_name}
            class="w-12 h-12 rounded-full object-cover border-2 border-navy-600"
          />
        ) : (
          <div class="w-12 h-12 rounded-full bg-navy-700 flex items-center justify-center text-white font-bold text-lg">
            {(blog.author_name ?? 'A').charAt(0).toUpperCase()}
          </div>
        )}
        <div>
          <p class="text-white font-semibold text-sm">{blog.author_name}</p>
          {blog.author_bio && (
            <p class="text-navy-400 text-xs leading-relaxed max-w-md">{blog.author_bio}</p>
          )}
        </div>
      </div>

      <!-- Body content (HTML rendered server-side) -->
      <div
        class="prose prose-invert prose-slate max-w-none
               prose-headings:text-white prose-headings:font-bold
               prose-p:text-navy-200 prose-p:leading-relaxed
               prose-a:text-blue-400 prose-a:no-underline hover:prose-a:underline
               prose-code:text-blue-300 prose-code:bg-navy-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
               prose-pre:bg-navy-900 prose-pre:border prose-pre:border-navy-700
               prose-blockquote:border-blue-500 prose-blockquote:text-navy-300
               prose-strong:text-white
               prose-li:text-navy-200"
        set:html={blog.content}
      />

      <!-- Tags -->
      {tags.length > 0 && (
        <div class="mt-10 pt-8 border-t border-navy-700">
          <p class="text-navy-400 text-xs font-semibold uppercase tracking-wider mb-3">Tags</p>
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="bg-navy-800 border border-navy-700 text-navy-300 text-xs px-3 py-1 rounded-full">
                {tag}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Back link -->
      <div class="mt-12">
        <a href="/blog" class="inline-flex items-center gap-2 text-blue-400 hover:text-blue-300 text-sm font-semibold transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Blog
        </a>
      </div>

    </article>
  )}

</BaseLayout>
