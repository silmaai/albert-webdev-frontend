---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getBlogs } from '../lib/api';
import type { Blog } from '../types/api';

let blogs: Blog[] = [];
try {
  blogs = await getBlogs(3);
} catch {
  blogs = [];
}
---

<BaseLayout title="Home" description="Albert WebDev — Hunter Albert's portfolio and personal site.">

  <!-- ─── Hero ─────────────────────────────────── -->
  <section class="relative bg-gradient-to-br from-navy-950 via-navy-900 to-navy-950 overflow-hidden">
    <!-- Background grid pattern -->
    <div class="absolute inset-0 opacity-5" style="background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 60px 60px;"></div>

    <!-- Glow -->
    <div class="absolute top-20 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-blue-700/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32 text-center">

      <!-- Name -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-3 font-mono">
        Hunter Albert
      </h1>

      <!-- Tagline -->
      <p class="text-blue-400 text-xl sm:text-2xl font-semibold font-mono mb-10 tracking-wide">
        Albert WebDev
      </p>

      <!-- Intro paragraphs -->
      <div class="text-navy-300 text-base sm:text-lg max-w-2xl mx-auto mb-10 leading-relaxed space-y-4 font-mono text-left">
        <p>
          Here you will find information about my professional experience, things I am working on or playing with, and learn about me as a person.
        </p>
        <p>
          I encourage you to click around, try to break things, and explore some of the special effort I have put into this showcase website.
        </p>
        <p>
          If you have questions, feedback, concerns, or simply want to hire me, send me an email!
        </p>
      </div>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/contact"
          class="bg-blue-600 hover:bg-blue-500 text-white font-semibold px-8 py-3.5 rounded-xl text-base transition-colors shadow-lg shadow-blue-900/40"
        >
          Get in Touch
        </a>
        <a
          href="https://github.com/Smackface"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-navy-800 hover:bg-navy-700 border border-navy-600 text-white font-semibold px-8 py-3.5 rounded-xl text-base transition-colors flex items-center gap-2"
        >
          <!-- GitHub icon -->
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
          GitHub
        </a>
      </div>
    </div>
  </section>

  <!-- ─── Blog Preview ──────────────────────── -->
  {blogs.length > 0 && (
    <section class="py-20 bg-navy-950">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between mb-10">
          <div>
            <h2 class="text-white text-3xl font-bold mb-2 font-mono">Latest Posts</h2>
            <p class="text-navy-400 text-sm">Thoughts on software, systems, and the craft of building things.</p>
          </div>
          <a href="/blog" class="hidden sm:block text-blue-400 hover:text-blue-300 text-sm font-semibold transition-colors">
            View all →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {blogs.map((blog) => (
            <BlogCard blog={blog} />
          ))}
        </div>

        <div class="mt-8 text-center sm:hidden">
          <a href="/blog" class="text-blue-400 hover:text-blue-300 text-sm font-semibold transition-colors">
            View all posts →
          </a>
        </div>
      </div>
    </section>
  )}

</BaseLayout>
