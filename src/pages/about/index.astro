---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExperienceTabs from '../../components/ExperienceTabs.svelte';

const tabs = [
  {
    label: 'AMS Enterprises',
    period: 'Jul 2025 – Present',
    sections: [
      {
        heading: 'HyperWork — Multi-Tenant SaaS CRM',
        body: 'Architected HyperWork, a multi-tenant serverless CRM platform with four-tier RBAC combining AWS Cognito group-level auth with per-tenant membership roles, enabling granular permissions where a single user can hold different access levels across different tenants. Built admin and superadmin dashboards with cross-tenant visibility, booking/scheduling interfaces, and real-time data analytics. Established 150+ unit tests (Jest + React Testing Library) and 23 E2E test suites (Playwright) covering auth flows, CRUD, booking workflows, and payment processing.',
      },
      {
        heading: 'Insight Technologies — Client Engagement',
        body: 'Engineered a production-grade ETL system with clean Extract/Transform/Load module separation, processing CSV data and reducing client workflow execution time by 80%. Implemented adaptive column mapping that detects and normalizes multiple CSV formats, enabling zero-touch ingestion across varied data sources. Delivered a data sanitization and storage microservice using AWS Lambda and Node.js integrated with Aurora RDS.',
      },
      {
        heading: 'Resume Builder',
        body: 'Built a resume builder and editor with user profiles, customizable templates, and dynamic content generation for faster, higher-quality candidate profile turnaround. Implemented Puppeteer-based server-side PDF rendering on EC2 managed by PM2, provisioned via AWS CDK stack defining VPC, EC2, Cognito, CloudFront, and automated deployment pipeline.',
      },
      {
        heading: 'Knights Hub',
        body: 'Architected a Knights of Columbus community web platform with dynamic component systems and an admin panel for content editing and publishing. Integrated Stripe for payments and built a highly configurable website configuration editor covering SEO, navigation, content, and page/component structuring.',
      },
    ],
    keywords: ['Next.js', 'React 19', 'TypeScript', 'NestJS', 'Node.js', 'AWS Amplify', 'Cognito', 'AppSync', 'DynamoDB', 'Lambda', 'Stripe', 'Puppeteer', 'CDK', 'Playwright', 'Jest'],
  },
  {
    label: 'Vendori',
    period: 'May 2024 – Apr 2025',
    sections: [
      {
        heading: 'Quote Management Platform',
        body: 'Architected a modular React / TypeScript frontend for a B2B quote management platform with drag-and-drop templating, rich text editing, a real-time pricing rule engine, multi-tenant approval workflows, and third-party customer deal rooms. Applied React optimization patterns — useMemo, useCallback, useDeferredValue — to reduce unnecessary re-renders by up to 35% in high-frequency real-time UI flows. Implemented Server Components, Server Actions, and Server Functions to reduce client bundle size.',
      },
      {
        heading: 'Serverless PDF Generation Microservice',
        body: 'Architected a high-performance serverless PDF generation microservice using AWS Lambda, Puppeteer, and TypeScript. Pre-fetched and cached 10+ API endpoints to eliminate network latency, implemented AWS IAM role assumption for secure S3 operations, and delivered enterprise-grade PDF documents in under 15 seconds while supporting multi-tenant authentication and cross-stage deployment automation.',
      },
      {
        heading: 'Backend Development',
        body: 'Delivered NestJS / Node.js / PostgreSQL backend functionality in support of the new frontend application, enabling parallel teams to focus on legacy maintenance without sacrificing forward progress. Collaborated with the CTO and Sr. Backend Engineer on systems design, architecting data structures to handle templated quote business requirements in a performant and scalable manner.',
      },
    ],
    keywords: ['React', 'Next.js', 'TypeScript', 'NestJS', 'Node.js', 'PostgreSQL', 'AWS Lambda', 'Puppeteer', 'Redux', 'S3', 'IAM'],
  },
  {
    label: 'Mathison Projects',
    period: 'Sep 2018 – Feb 2024',
    sections: [
      {
        heading: 'Full-Stack Blog Platform',
        body: 'Designed and launched a full-stack Next.js blog platform leveraging AWS Amplify, GraphQL/AppSync, and serverless Lambda functions, enabling seamless content delivery and supporting 6+ structured content types with DynamoDB and S3 storage.',
      },
      {
        heading: 'AWS Infrastructure as Code Application',
        body: 'Led development of an AWS IaC application provisioning nearly a dozen DynamoDB tables with optimized GSI layouts for multi-tenant access patterns, reducing query latency by 25%. Automated S3 static website hosting with CloudFront CDN distributions and authored comprehensive DevOps CI/CD automation scripts with deployment validation and rollback capabilities.',
      },
      {
        heading: 'Drag-and-Drop Website Builder',
        body: 'Architected a full-stack drag-and-drop website builder using Next.js, React, and TypeScript, integrated with AWS Amplify for GraphQL API management, Cognito for authentication, S3 for file storage, and AWS SAM with Lambda for serverless backend processing. Featured 15+ reusable components (video banners, carousels, galleries, contact forms, news feeds), real-time page builder, integrated file manager, and multi-domain deployment support.',
      },
    ],
    keywords: ['React', 'Next.js', 'Vue.js', 'Svelte', 'TypeScript', 'Node.js', 'NestJS', 'AWS Amplify', 'AppSync', 'Lambda', 'DynamoDB', 'S3', 'CloudFront', 'Cognito', 'CloudFormation'],
  },
  {
    label: 'Skills',
    period: '',
    sections: [
      {
        heading: 'Frontend',
        body: 'React, Next.js, TypeScript, JavaScript, Astro, Svelte, Vue.js, Radix UI, Material UI, Ant Design, Vuetify, TailwindCSS, SASS/SCSS, Redux, React Testing Library',
      },
      {
        heading: 'Backend',
        body: 'Node.js, NestJS, Express, PostgreSQL, DynamoDB, MongoDB, SQLite, Aurora RDS, Serverless Framework, Prisma',
      },
      {
        heading: 'AWS',
        body: 'Amplify (Gen 1 & 2), Lambda, AppSync, Cognito, DynamoDB, S3, CloudFront, SQS, SNS, SES, EC2, ECS, API Gateway, CloudFormation, CDK, CodePipeline, CodeBuild, CodeDeploy, Parameter Store, Secrets Manager, IAM, KMS, Route53, ALB/ELB, VPC',
      },
      {
        heading: 'DevOps & Tooling',
        body: 'Git, CI/CD, Jenkins, Terraform, Docker, PM2, AWS CLI, IaC, Playwright (23 E2E suites), Jest (150+ unit tests), Puppeteer',
      },
    ],
    keywords: [],
  },
];

const certs = [
  {
    name: 'AWS Certified Developer – Associate',
    issuer: 'Amazon Web Services',
    issued: 'November 2025',
    expires: 'November 2028',
    verifyUrl: 'https://aws.amazon.com/verification',
    verifyId: 'd99acf0ee100407c837f725d16faf867',
    pdfUrl: '/certs/aws-dva-c02.pdf',
    badge: 'DVA-C02',
  },
  {
    name: 'Certified Senior React Developer',
    issuer: 'Certificates.dev',
    issued: 'January 2026',
    expires: null,
    verifyUrl: 'https://certificates.dev/c/a0db2575-9ec8-4d4d-b481-5fa0916c0450',
    verifyId: 'CSRD-008164',
    pdfUrl: '/certs/senior-react-developer.pdf',
    badge: 'CSRD',
  },
];
---

<BaseLayout title="About" description="Learn about Hunter Albert — Senior Software Engineer.">

  <!-- ─── Page Header ───────────────────────── -->
  <section class="bg-gradient-to-br from-navy-950 via-navy-900 to-navy-950 border-b border-navy-800 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white font-mono mb-3">
        <a
          href="https://www.linkedin.com/in/hunter-koenig-albert-b55a81221/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-blue-400 transition-colors"
        >
          About Hunter
        </a>
      </h1>
      <p class="text-navy-400 font-mono text-sm">Senior Software Engineer · 6+ Years · New Bern, NC</p>
    </div>
  </section>

  <!-- ─── Personal / Professional Intro ───── -->
  <section class="py-16 bg-navy-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <h2 class="text-blue-400 font-mono font-semibold text-sm uppercase tracking-widest mb-8">
        Background
      </h2>

      <div class="space-y-5 text-navy-300 font-mono text-sm leading-relaxed">
        <p>
          I am a results-driven Senior Software Engineer with over 6 years of experience building and shipping production software. My focus spans the full stack — React, Next.js, TypeScript, Node.js, NestJS, and AWS — with particular depth in frontend architecture, serverless infrastructure, and event-driven systems. I hold the AWS DVA-C02 Developer Associate certification and am a Certified Senior React Developer (Certificates.dev).
        </p>
        <p>
          I transitioned into software development in 2018 after a personal setback that prompted a deliberate career change. Within one month of self-directed study I had enough foundation to join Mathison Projects Inc. as an intern, and within two months I was contributing meaningfully to production codebases. I reached mid-level developer in under two years.
        </p>
        <p>
          My approach to engineering is built around clarity of ownership and a strong preference for solving hard problems correctly the first time. I have led teams, mentored interns, and served clients across Healthcare, Commerce, FinTech, and B2B SaaS. Outside of professional work, I am actively developing expertise in Go for systems-level personal projects.
        </p>
        <p>
          If you are looking for an engineer who takes ownership from spec to deployment and communicates clearly throughout — I would enjoy hearing about what you are building.
        </p>
      </div>

      <div class="mt-10">
        <a
          href="/contact"
          class="inline-block bg-blue-600 hover:bg-blue-500 text-white font-semibold font-mono px-6 py-3 rounded-xl text-sm transition-colors shadow-lg shadow-blue-900/40"
        >
          Get in touch →
        </a>
      </div>
    </div>
  </section>

  <!-- ─── Certifications ────────────────────── -->
  <section class="py-16 bg-navy-950 border-t border-navy-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <h2 class="text-blue-400 font-mono font-semibold text-sm uppercase tracking-widest mb-8">
        Certifications
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {certs.map((cert) => (
          <div class="bg-navy-900 border border-navy-700 rounded-2xl p-6 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-3 mb-3">
                <span class="bg-blue-600 text-white text-xs font-mono font-bold px-2.5 py-1 rounded-md">
                  {cert.badge}
                </span>
                {cert.expires && (
                  <span class="text-navy-400 font-mono text-xs">Expires {cert.expires}</span>
                )}
              </div>
              <h3 class="text-white font-mono font-semibold text-base mb-1">{cert.name}</h3>
              <p class="text-navy-400 font-mono text-xs mb-1">{cert.issuer} · Issued {cert.issued}</p>
              <p class="text-navy-500 font-mono text-xs">ID: {cert.verifyId}</p>
            </div>
            <div class="flex gap-3 mt-5">
              <a
                href={cert.pdfUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 text-center bg-navy-800 hover:bg-navy-700 border border-navy-600 text-navy-200 font-mono text-xs font-semibold py-2 rounded-lg transition-colors"
              >
                View PDF
              </a>
              <a
                href={cert.verifyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 text-center bg-blue-600 hover:bg-blue-500 text-white font-mono text-xs font-semibold py-2 rounded-lg transition-colors"
              >
                Verify ↗
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Professional Experience ──────────── -->
  <section class="py-16 bg-navy-900 border-t border-navy-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <h2 class="text-blue-400 font-mono font-semibold text-sm uppercase tracking-widest mb-8">
        Professional Experience
      </h2>

      <ExperienceTabs client:load tabs={tabs} />

    </div>
  </section>

</BaseLayout>
