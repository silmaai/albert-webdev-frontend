---
import type { Career } from '../types/api';

interface Props {
  career: Career;
}

const { career } = Astro.props;

const applyHref = career.social_link || '/contact';
const isExternal = career.social_link?.startsWith('http');
---

<article class="bg-navy-900 border border-navy-700 rounded-xl p-6 hover:border-blue-500 transition-colors">
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">

    <div class="flex-1 min-w-0">
      <!-- Title -->
      <h3 class="text-white font-bold text-xl mb-2">
        {career.title}
      </h3>

      <!-- Description excerpt (first 200 chars) -->
      <p class="text-navy-300 text-sm leading-relaxed mb-4">
        {career.description.length > 200
          ? career.description.slice(0, 200) + '…'
          : career.description}
      </p>

      <!-- Duties (if present) -->
      {career.duties && (
        <div class="text-navy-400 text-xs leading-relaxed">
          <span class="font-semibold text-navy-300">Key duties: </span>
          {career.duties.length > 150
            ? career.duties.slice(0, 150) + '…'
            : career.duties}
        </div>
      )}
    </div>

    <!-- CTA -->
    <div class="shrink-0">
      <a
        href={applyHref}
        target={isExternal ? '_blank' : undefined}
        rel={isExternal ? 'noopener noreferrer' : undefined}
        class="inline-flex items-center gap-1.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors whitespace-nowrap"
      >
        Apply Now
        {isExternal && (
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        )}
      </a>
    </div>
  </div>
</article>
