---
import type { Blog } from '../types/api';

interface Props {
  blog: Blog;
}

const { blog } = Astro.props;
---

<article class="bg-navy-900 border border-navy-700 rounded-xl overflow-hidden hover:border-blue-500 transition-colors group">
  <div class="p-6 flex flex-col h-full">

    <!-- Category badge -->
    {blog.category && (
      <span class="inline-block bg-blue-900/60 text-blue-300 text-xs font-semibold px-2.5 py-1 rounded-full mb-3 self-start">
        {blog.category}
      </span>
    )}

    <!-- Title -->
    <h3 class="text-white font-bold text-lg leading-snug mb-3 group-hover:text-blue-400 transition-colors">
      <a href={`/blog/${blog.guid}`} class="stretched-link">
        {blog.short_title}
      </a>
    </h3>

    <!-- Short description -->
    <p class="text-navy-300 text-sm leading-relaxed flex-1 mb-4">
      {blog.short_description}
    </p>

    <!-- Footer: author + read more -->
    <div class="flex items-center justify-between mt-auto pt-4 border-t border-navy-700">
      <span class="text-navy-400 text-xs font-medium">
        {blog.author_name}
      </span>
      <a
        href={`/blog/${blog.guid}`}
        class="text-blue-400 hover:text-blue-300 text-xs font-semibold transition-colors"
      >
        Read more →
      </a>
    </div>
  </div>
</article>
